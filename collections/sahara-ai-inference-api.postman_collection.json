    "_postman_id": "ce9e1810-3b4d-46e6-b194-ee060e751a2e",
    "name": "Sahara AI Compute Discovery Inference API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OpenAI-compatible inference and model-discovery API for the Sahara AI Developer Platform. Exposes a routed compute layer that fans requests out across multiple upstream providers (OpenAI, Lepton, Together, and others), plus discovery endpoints for the models and providers available on the network. Faithful transcription of the published API documentation; not a provider-published OpenAPI.\n\nContact Support:\n Name: Sahara AI Developer Platform",
      "type": "text/plain"
    }
  }
